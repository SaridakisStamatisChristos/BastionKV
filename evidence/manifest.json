  "claims": [
    {
      "claim": "Atomic synchronous recovery of acknowledged multi-key commits",
      "status": "demonstrated",
      "evidence": [
        "tests/crash.rs",
        "tests/corruption.rs"
      ],
      "limitations": [
        "process crashes are not physical power cuts; filesystem sync/rename assumptions apply"
      ]
    },
    {
      "claim": "Stable snapshot point/scan visibility through writes and compaction",
      "status": "demonstrated",
      "evidence": [
        "tests/semantics.rs",
        "tests/concurrency.rs",
        "tests/reference.rs"
      ],
      "limitations": [
        "process-local immutable maps; 128 registered snapshot cap"
      ]
    },
    {
      "claim": "Complete corruption and structural invalidity fail closed with bounded parser allocation",
      "status": "demonstrated",
      "evidence": [
        "tests/corruption.rs"
      ],
      "limitations": [
        "CRC is integrity detection, not authentication; hostile directory-owner races are excluded"
      ]
    },
    {
      "claim": "Crash-safe checkpoint generation publication without delete resurrection",
      "status": "demonstrated",
      "evidence": [
        "tests/crash.rs",
        "tests/reference.rs"
      ],
      "limitations": [
        "explicit full compaction; declared filesystem assumptions apply"
      ]
    },
    {
      "claim": "Physical power-loss, non-Linux durability, production certification, or performance superiority",
      "status": "unverified",
      "evidence": []
    }
  ],
